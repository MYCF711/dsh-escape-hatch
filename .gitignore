# Dependencies — this plugin has none, but keep the ignore rules for safety
node_modules/

# Logs and debug output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor and OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Local environment
.env
.env.local

# NOTE: lib/ is intentionally NOT ignored.
# The DSH runtime consumes built artifacts directly and has no install-time
# build step for plugins, so the bundled client must be committed.
